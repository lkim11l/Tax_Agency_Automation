# Application
APP_URL=http://localhost:3000
NODE_ENV=development
APP_ENV=development
CRON_SECRET=
BACKGROUND_JOB_LOCK_TIMEOUT_SECONDS=300
BACKGROUND_JOB_MIN_INTERVAL_SECONDS=60
BACKGROUND_JOB_MAX_ATTEMPTS=3
BACKGROUND_DOCUMENT_BATCH_SIZE=25
BACKGROUND_EXTRACTION_BATCH_SIZE=5

# Database
DATABASE_URL=

# Authentication
AUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use this instead of NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical server-only key for the email worker. Never use NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Temporary compatibility alias; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Hosted integration-test users provisioned through Supabase Dashboard
SUPABASE_TEST_ADMIN_EMAIL=
SUPABASE_TEST_ADMIN_PASSWORD=
SUPABASE_TEST_SPECIALIST_EMAIL=
SUPABASE_TEST_SPECIALIST_PASSWORD=
SUPABASE_TEST_INACTIVE_EMAIL=
SUPABASE_TEST_INACTIVE_PASSWORD=

# AI (server-only; never use a NEXT_PUBLIC_ prefix)
OPENAI_API_KEY=

# Mail.ru email ingestion (server-only)
EMAIL_PROVIDER=mailru
EMAIL_FROM=
# Canonical IMAP names
EMAIL_IMAP_HOST=imap.mail.ru
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_IMAP_FOLDER=INBOX
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
# Canonical SMTP names
EMAIL_SMTP_HOST=smtp.mail.ru
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
# Temporary compatibility aliases for existing local configuration
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
# Optional prefix used only by the read-only live acceptance command
EMAIL_LIVE_TEST_PREFIX=TAA-PHASE2-LIVE-

# Storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
