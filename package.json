{
  "name": "tax-agency-automation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "db:lint": "supabase db lint",
    "email:check": "node --env-file=.env.local --import tsx scripts/email-check.ts",
    "email:sync": "node --env-file=.env.local --import tsx scripts/email-sync.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:email:live": "node --env-file=.env.local --import tsx scripts/email-live.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "imapflow": "1.4.9",
    "mailparser": "3.9.14",
    "next": "16.2.11",
    "nodemailer": "9.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@types/mailparser": "3.4.6",
    "@types/node": "latest",
    "@types/nodemailer": "8.0.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "latest",
    "eslint-config-next": "16.2.11",
    "supabase": "^2.109.1",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.10",
    "sharp": "0.35.0"
  }
}
